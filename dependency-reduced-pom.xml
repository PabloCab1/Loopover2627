<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.loopover</groupId>
  <artifactId>loopover</artifactId>
  <name>loopover</name>
  <version>0.1.0</version>
  <description>Búsqueda en espacio de estado para resolver el puzzle Loopover con movimientos encadenados.</description>
  <build>
    <sourceDirectory>src</sourceDirectory>
    <finalName>loopover</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>${main.class}</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <main.class>LoopoverApp</main.class>
    <picocli.version>4.7.7</picocli.version>
    <fastutil.version>8.5.16</fastutil.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <guava.version>33.7.1-jre</guava.version>
  </properties>
</project>
